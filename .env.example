# Database Connection String
POSTGRES_USER=apmc_admin
POSTGRES_PASSWORD=your_secure_password
DB_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/apmc_forecasting

# Dynamic Economic & Logistics Configurations
# Price Elasticity of Demand (Source: RBI ARDL Models)
ELASTICITY_COEFFICIENT=0.721
# Post-Harvest Spoilage Rate (Source: NABCONS Transit Loss)
SPOILAGE_RATE_PER_HOUR=0.001

# Truck & Freight Variables
AVERAGE_TRUCK_SPEED_KMPH=40.0
CURRENT_DIESEL_PRICE=90.0
TRUCK_MILEAGE_KMPL=15.0
BASE_LOADING_CHARGE=500
